# -----------------------------------------------
# l3mcore .gitignore
# -----------------------------------------------

# Virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.pycache
.pytest_cache/

# Binary models (too large for Git)
*.onnx
*.gguf
*.bin
*.safetensors
*.pt
*.pth
models/*/

# Runtime data
data/
logs/

# Environment / secrets
.env
.env.*
*.secret

# Backups
*.bak
*.tmp

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Tests
tests/
